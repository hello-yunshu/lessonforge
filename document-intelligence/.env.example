# Phase 12 Release Candidate: production profile is fail-closed.
DI_DEPLOYMENT_PROFILE=development
# Production requires an absolute workspace and tenant token digests.
DI_API_TENANT_TOKENS_SHA256_JSON={}
DI_API_REQUESTS_PER_MINUTE=120
DI_API_MAX_CONCURRENT_REQUESTS_PER_TENANT=4
DI_API_REQUEST_TIMEOUT_SECONDS=120
DI_METRICS_ACCESS_TOKEN_SHA256=
DI_SINGLE_NODE_MODE=true
# Development defaults to the optional PyMuPDF renderer for compatibility.
# Production compose defaults to disabled unless licensing is explicitly resolved.
DI_PDF_RENDER_BACKEND=pymupdf
DI_PYMUPDF_LICENSE_RESOLVED=false
# Digest-pinned Docker image required by the production compose file.
DI_PYTHON_BASE_IMAGE=
DI_HOST_PORT=8080

DI_WORKSPACE=./var
DI_MAX_UPLOAD_BYTES=52428800
DI_MAX_PDF_PAGES=2000
DI_MAX_PAGE_ELEMENTS=20000
DI_MAX_DOCUMENT_ELEMENTS=200000
DI_MAX_BINARY_ARTIFACT_BYTES=209715200
DI_MAX_RENDER_PIXELS=50000000
# 可选；不设置时使用包内安全默认配置
DI_PARSER_CONFIG=./configs/parsers.yaml
DI_DEFAULT_PARSER=auto
DI_ENABLE_STANDARD_WRITES=false
# 标准库管理与标准正文返回令牌的 SHA-256；留空时默认拒绝访问
DI_STANDARD_ACCESS_TOKEN_SHA256=
DI_MATCH_HIGH_THRESHOLD=0.86
DI_MATCH_LOCAL_THRESHOLD=0.78
DI_MATCH_MIN_MARGIN=0.08
DI_MATCH_MIN_LOCAL_INLIERS=10
DI_PADDLE_ENDPOINT=
DI_OPENDOC_ENDPOINT=
DI_MINERU_ENDPOINT=

# Phase 3 generic structure recovery
DI_STRUCTURE_MAX_COLUMNS=4
DI_STRUCTURE_SPANNING_WIDTH=0.70
DI_STRUCTURE_COLUMN_GAP=0.18
DI_STRUCTURE_REPEATED_MARGIN_RATIO=0.60
DI_STRUCTURE_CAPTION_THRESHOLD=0.70
DI_STRUCTURE_CROSS_PAGE_THRESHOLD=0.70

# Phase 4 Domain Pack Runtime; writes and management access default closed.
DI_ENABLE_DOMAIN_PACK_WRITES=false
# SHA-256 of the API management token; blank means management/readback APIs deny access.
DI_DOMAIN_PACK_ACCESS_TOKEN_SHA256=
DI_DOMAIN_PACK_REQUIRE_SIGNATURES=false
# JSON object: {"key-id":"base64-ed25519-public-key"}
DI_DOMAIN_PACK_TRUSTED_KEYS_JSON={}
DI_DOMAIN_PACK_MAX_ARCHIVE_FILES=2000
DI_DOMAIN_PACK_MAX_ARCHIVE_BYTES=134217728
DI_DOMAIN_PACK_MAX_COMPRESSION_RATIO=100

# Rill Shadow. The default is disabled and cannot alter production actions.
# Production consumer path is Stable IPC v2. "preview-v3" is qualification-only.
DI_RILL_SHADOW_BACKEND=disabled
# JSON argv, never a shell string. Example: ["/absolute/rill-runtime","serve",...]
DI_RILL_RUNTIME_COMMAND_JSON=
DI_RILL_EVALUATE_CAPABILITY=org.lessonforge.shadow.evaluate
DI_RILL_FEEDBACK_CAPABILITY=org.lessonforge.shadow.update
# SHA-256 of X-Rill-Token; blank means all Rill management/readback APIs deny access.
DI_RILL_ACCESS_TOKEN_SHA256=
DI_ENABLE_RILL_SHADOW_WRITES=false
# Test/development only; never present this backend as the real rill-runtime.
DI_RILL_REFERENCE_BACKEND_ALLOWED=false
DI_RILL_REQUEST_TIMEOUT_SECONDS=5
DI_RILL_STARTUP_TIMEOUT_SECONDS=5
DI_RILL_MAX_MESSAGE_BYTES=1048576
DI_RILL_DRIFT_MIN_SAMPLES=20
DI_RILL_DRIFT_THRESHOLD=5
DI_RILL_DRIFT_DELTA=0.01

# Phase 6 Rill Assist. Qualification records may be produced only when writes are enabled.
# Execution is a separate, stricter switch and still requires a qualified, unexpired,
# operator-approved activation. boundedAuto is hard-disabled.
DI_ENABLE_RILL_ASSIST_WRITES=false
DI_ENABLE_RILL_ASSIST_EXECUTION=false
DI_RILL_ASSIST_ACCESS_TOKEN_SHA256=
DI_RILL_ASSIST_MIN_EXPERT_FEEDBACK=30
DI_RILL_ASSIST_MIN_PRODUCTION_LIKE_FEEDBACK=30
DI_RILL_ASSIST_MIN_ACCURACY=0.90
DI_RILL_ASSIST_QUALIFICATION_TTL_HOURS=168
DI_RILL_ASSIST_MIN_ACTION_FEEDBACK=5
# Required before Assist can qualify a real deployment.
DI_RILL_RUNTIME_ARTIFACT_SHA256=
DI_RILL_MODEL_ARTIFACT_SHA256=
DI_RILL_HANDLER_ARTIFACT_SHA256=

# Phase 7 continuous learning and MLOps. Registration and release are separate gates.
DI_ENABLE_MLOPS_WRITES=false
DI_ENABLE_MLOPS_RELEASE=false
# SHA-256 of X-MLOps-Token; blank means MLOps APIs deny access.
DI_MLOPS_ACCESS_TOKEN_SHA256=
DI_MLOPS_MINIMUM_ACCURACY=0.90
DI_MLOPS_MINIMUM_CHALLENGE_IMPROVEMENT=0.001
DI_MLOPS_MAXIMUM_LATENCY_MS_P95=30000
DI_MLOPS_MAXIMUM_COST_USD_PER_DOCUMENT=10
DI_MLOPS_MAXIMUM_FAMILY_REGRESSION=0.02
DI_MLOPS_MINIMUM_SHADOW_SAMPLES=100

# Phase 10 production qualification. Evidence registration is default closed.
# SHA-256 of X-Production-Qualification-Token; blank means APIs deny access.
DI_ENABLE_PRODUCTION_QUALIFICATION_WRITES=false
DI_PRODUCTION_QUALIFICATION_ACCESS_TOKEN_SHA256=
DI_PRODUCTION_MINIMUM_DOMAINS=3
DI_PRODUCTION_MINIMUM_GOLD_DOCUMENTS=100
DI_PRODUCTION_MINIMUM_CHALLENGE_DOCUMENTS=50
DI_PRODUCTION_MINIMUM_PARSER_ACCURACY=0.90
DI_PRODUCTION_MAXIMUM_PARSER_TIMEOUT_RATE=0.01
DI_PRODUCTION_MAXIMUM_PARSER_FAILURE_RATE=0.01
DI_PRODUCTION_MINIMUM_DETERMINISTIC_REPLAY_RATE=1.0
DI_PRODUCTION_MINIMUM_SOAK_HOURS=168
DI_PRODUCTION_MINIMUM_SCALE_CONCURRENCY=8
DI_PRODUCTION_MINIMUM_SCALE_DOCUMENTS=10000
DI_PRODUCTION_MAXIMUM_SCALE_ERROR_RATE=0.01
DI_PRODUCTION_MINIMUM_BRANCH_COVERAGE=80
DI_PRODUCTION_MINIMUM_PILOT_DAYS=7
DI_PRODUCTION_MINIMUM_PILOT_DOCUMENTS=500
DI_PRODUCTION_MINIMUM_PILOT_EXPERT_REVIEWS=100
DI_PRODUCTION_MINIMUM_PILOT_ACCURACY=0.90

# Phase 11 qualification campaign orchestration (default closed)
DI_ENABLE_QUALIFICATION_CAMPAIGN_WRITES=false
DI_QUALIFICATION_CAMPAIGN_ACCESS_TOKEN_SHA256=
DI_QUALIFICATION_CAMPAIGN_MAXIMUM_LEASE_SECONDS=86400
DI_QUALIFICATION_CAMPAIGN_MAX_BUNDLE_BYTES=33554432

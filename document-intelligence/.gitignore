__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.venv/
.env
var/runs/*
var/raw/*
var/sources/*
var/assets/*
var/standard/*
!var/runs/.gitkeep
!var/raw/.gitkeep
!var/sources/.gitkeep
!var/assets/.gitkeep
!var/standard/.gitkeep
*.egg-info/
dist/
build/
var/mlops/*
!var/mlops/.gitkeep

# 运行期教材解析数据（含教材版权内容），不随源码发布
var/structures/*
!var/structures/.gitkeep
var/textbook/*
var/rill-shadow/*
var/visual-semantic/*

# 运行期领域数据包与解析结果
var/domain-packs/*
!var/domain-packs/.gitkeep
var/domain-results/*
!var/domain-results/.gitkeep
var/domain-reviews/*
!var/domain-reviews/.gitkeep

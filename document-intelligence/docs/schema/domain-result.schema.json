{
  "$defs": {
    "DomainAnnotation": {
      "additionalProperties": false,
      "properties": {
        "annotation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Annotation Id",
          "type": "string"
        },
        "element_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Element Id",
          "type": "string"
        },
        "domain_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Domain Type",
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "title": "Properties"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "rule_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Rule Id",
          "type": "string"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "unreviewed"
        }
      },
      "required": [
        "annotation_id",
        "element_id",
        "domain_type",
        "confidence",
        "evidence_ids",
        "rule_id"
      ],
      "title": "DomainAnnotation",
      "type": "object"
    },
    "DomainExecutionStatus": {
      "enum": [
        "succeeded",
        "fallback_generic"
      ],
      "title": "DomainExecutionStatus",
      "type": "string"
    },
    "DomainMetrics": {
      "additionalProperties": false,
      "properties": {
        "source_elements": {
          "minimum": 0,
          "title": "Source Elements",
          "type": "integer"
        },
        "source_relations": {
          "minimum": 0,
          "title": "Source Relations",
          "type": "integer"
        },
        "annotations": {
          "minimum": 0,
          "title": "Annotations",
          "type": "integer"
        },
        "domain_relations": {
          "minimum": 0,
          "title": "Domain Relations",
          "type": "integer"
        },
        "validation_findings": {
          "minimum": 0,
          "title": "Validation Findings",
          "type": "integer"
        },
        "error_findings": {
          "minimum": 0,
          "title": "Error Findings",
          "type": "integer"
        },
        "annotation_evidence_coverage": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Annotation Evidence Coverage",
          "type": "number"
        },
        "fallback_used": {
          "default": false,
          "title": "Fallback Used",
          "type": "boolean"
        }
      },
      "required": [
        "source_elements",
        "source_relations",
        "annotations",
        "domain_relations",
        "validation_findings",
        "error_findings",
        "annotation_evidence_coverage"
      ],
      "title": "DomainMetrics",
      "type": "object"
    },
    "DomainRelationAnnotation": {
      "additionalProperties": false,
      "properties": {
        "relation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Relation Id",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "domain_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Domain Type",
          "type": "string"
        },
        "base_relation_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Base Relation Type",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "rule_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Rule Id",
          "type": "string"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "unreviewed"
        }
      },
      "required": [
        "relation_id",
        "source_id",
        "target_id",
        "domain_type",
        "base_relation_type",
        "confidence",
        "evidence_ids",
        "rule_id"
      ],
      "title": "DomainRelationAnnotation",
      "type": "object"
    },
    "DomainValidationFinding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "element_ids": {
          "items": {
            "type": "string"
          },
          "title": "Element Ids",
          "type": "array"
        },
        "relation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Relation Ids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "DomainValidationFinding",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "unreviewed",
        "reviewed",
        "rejected"
      ],
      "title": "ReviewStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "domain_result_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Domain Result Id",
      "type": "string"
    },
    "domain_schema_version": {
      "default": "1.0",
      "title": "Domain Schema Version",
      "type": "string"
    },
    "runtime_version": {
      "maxLength": 63,
      "minLength": 1,
      "title": "Runtime Version",
      "type": "string"
    },
    "runtime_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Digest",
      "type": "string"
    },
    "structure_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Structure Id",
      "type": "string"
    },
    "source_structure_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Structure Digest",
      "type": "string"
    },
    "document_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Document Id",
      "type": "string"
    },
    "parse_run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Parse Run Id",
      "type": "string"
    },
    "pack_id": {
      "pattern": "^[a-z][a-z0-9-]{0,62}$",
      "title": "Pack Id",
      "type": "string"
    },
    "pack_version": {
      "maxLength": 63,
      "minLength": 1,
      "title": "Pack Version",
      "type": "string"
    },
    "pack_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Pack Digest",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/DomainExecutionStatus"
    },
    "annotations": {
      "items": {
        "$ref": "#/$defs/DomainAnnotation"
      },
      "title": "Annotations",
      "type": "array"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/DomainRelationAnnotation"
      },
      "title": "Relations",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/DomainValidationFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "metrics": {
      "$ref": "#/$defs/DomainMetrics"
    },
    "failure_code": {
      "anyOf": [
        {
          "maxLength": 127,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Code"
    },
    "failure_message": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Message"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    }
  },
  "required": [
    "domain_result_id",
    "runtime_version",
    "runtime_digest",
    "structure_id",
    "source_structure_digest",
    "document_id",
    "parse_run_id",
    "pack_id",
    "pack_version",
    "pack_digest",
    "status",
    "metrics"
  ],
  "title": "DomainResult",
  "type": "object"
}

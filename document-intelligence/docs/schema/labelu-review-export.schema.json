{
  "$defs": {
    "BoundingBox": {
      "additionalProperties": false,
      "properties": {
        "x1": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y1",
          "type": "number"
        },
        "x2": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X2",
          "type": "number"
        },
        "y2": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y2",
          "type": "number"
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "LabelUObject": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "element_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Element Id",
          "type": "string"
        },
        "label": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "element_id",
        "label",
        "bbox",
        "confidence",
        "evidence_ids"
      ],
      "title": "LabelUObject",
      "type": "object"
    },
    "LabelURelation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "label": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "source_id",
        "target_id",
        "label",
        "confidence",
        "evidence_ids"
      ],
      "title": "LabelURelation",
      "type": "object"
    },
    "LabelUTask": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Task Id",
          "type": "string"
        },
        "page_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Page Id",
          "type": "string"
        },
        "image_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Ref"
        },
        "objects": {
          "items": {
            "$ref": "#/$defs/LabelUObject"
          },
          "title": "Objects",
          "type": "array"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/LabelURelation"
          },
          "title": "Relations",
          "type": "array"
        }
      },
      "required": [
        "task_id",
        "page_id"
      ],
      "title": "LabelUTask",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "const": "labelu-json-v1",
      "default": "labelu-json-v1",
      "title": "Adapter",
      "type": "string"
    },
    "export_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Export Id",
      "type": "string"
    },
    "domain_result_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Domain Result Id",
      "type": "string"
    },
    "source_domain_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Domain Digest",
      "type": "string"
    },
    "pack_id": {
      "title": "Pack Id",
      "type": "string"
    },
    "pack_version": {
      "title": "Pack Version",
      "type": "string"
    },
    "object_labels": {
      "items": {
        "type": "string"
      },
      "title": "Object Labels",
      "type": "array"
    },
    "relation_labels": {
      "items": {
        "type": "string"
      },
      "title": "Relation Labels",
      "type": "array"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/LabelUTask"
      },
      "title": "Tasks",
      "type": "array"
    },
    "cross_page_relations": {
      "items": {
        "$ref": "#/$defs/LabelURelation"
      },
      "title": "Cross Page Relations",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "export_id",
    "domain_result_id",
    "source_domain_digest",
    "pack_id",
    "pack_version",
    "tasks"
  ],
  "title": "LabelUReviewExport",
  "type": "object"
}

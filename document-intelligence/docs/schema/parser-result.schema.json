{
  "$defs": {
    "BaseType": {
      "enum": [
        "text",
        "heading",
        "image",
        "figure",
        "formula",
        "table",
        "icon",
        "character",
        "callout",
        "list",
        "footnote",
        "page_number",
        "input_area",
        "separator",
        "unknown"
      ],
      "title": "BaseType",
      "type": "string"
    },
    "BoundingBox": {
      "additionalProperties": false,
      "properties": {
        "x1": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y1",
          "type": "number"
        },
        "x2": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X2",
          "type": "number"
        },
        "y2": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y2",
          "type": "number"
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "Confidence": {
      "additionalProperties": false,
      "properties": {
        "overall": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Overall",
          "type": "number"
        },
        "detection": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detection"
        },
        "recognition": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recognition"
        }
      },
      "required": [
        "overall"
      ],
      "title": "Confidence",
      "type": "object"
    },
    "DocumentIdentity": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Family"
        },
        "edition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edition"
        },
        "external_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        }
      },
      "title": "DocumentIdentity",
      "type": "object"
    },
    "Element": {
      "additionalProperties": false,
      "properties": {
        "element_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Element Id",
          "type": "string"
        },
        "page_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Page Id",
          "type": "string"
        },
        "base_type": {
          "$ref": "#/$defs/BaseType"
        },
        "subtype": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Subtype",
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        },
        "pixel_bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/PixelBoundingBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content": {
          "$ref": "#/$defs/ElementContent"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "unreviewed"
        },
        "domain_annotations": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Domain Annotations",
          "type": "array"
        },
        "reading_order": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reading Order"
        }
      },
      "required": [
        "element_id",
        "page_id",
        "base_type",
        "subtype",
        "bbox",
        "content",
        "confidence",
        "evidence_ids"
      ],
      "title": "Element",
      "type": "object"
    },
    "ElementContent": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "latex": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latex"
        },
        "table": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "asset_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Ref"
        }
      },
      "title": "ElementContent",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "producer": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Producer Version",
          "type": "string"
        },
        "model_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Digest",
          "type": "string"
        },
        "parse_run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Parse Run Id",
          "type": "string"
        },
        "source_page_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Page Id"
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundingBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "raw_output_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Output Ref"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "producer",
        "producer_version",
        "model_digest",
        "parse_run_id"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "native_extraction",
        "model_prediction",
        "rule_inference",
        "human_review",
        "external_reference"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "JsonValue": {},
    "Page": {
      "additionalProperties": false,
      "properties": {
        "page_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Page Id",
          "type": "string"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "rotation": {
          "default": 0,
          "title": "Rotation",
          "type": "integer"
        },
        "element_ids": {
          "items": {
            "type": "string"
          },
          "title": "Element Ids",
          "type": "array"
        },
        "image_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Ref"
        }
      },
      "required": [
        "page_id",
        "index",
        "width",
        "height"
      ],
      "title": "Page",
      "type": "object"
    },
    "ParseErrorRecord": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "pattern": "^P[0-2]$",
          "title": "Severity",
          "type": "string"
        },
        "parser_id": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Parser Id",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "severity",
        "parser_id"
      ],
      "title": "ParseErrorRecord",
      "type": "object"
    },
    "ParseRun": {
      "additionalProperties": false,
      "properties": {
        "parse_run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Parse Run Id",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "parser_id": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Parser Id",
          "type": "string"
        },
        "parser_version": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Parser Version",
          "type": "string"
        },
        "parser_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Parser Digest",
          "type": "string"
        },
        "config_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Digest",
          "type": "string"
        },
        "request_context_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Context Digest",
          "type": "string"
        },
        "domain_pack": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain Pack"
        },
        "rule_pack": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Pack"
        },
        "rill_decision_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rill Decision Id"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "semantic_output_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Output Digest"
        },
        "resource_usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ParseWarning"
          },
          "title": "Warnings",
          "type": "array"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ParseErrorRecord"
          },
          "title": "Errors",
          "type": "array"
        }
      },
      "required": [
        "parse_run_id",
        "input_sha256",
        "parser_id",
        "parser_version",
        "parser_digest",
        "config_digest",
        "request_context_digest",
        "status",
        "started_at"
      ],
      "title": "ParseRun",
      "type": "object"
    },
    "ParseWarning": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "P2",
          "pattern": "^P[0-2]$",
          "title": "Severity",
          "type": "string"
        },
        "page_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Id"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ParseWarning",
      "type": "object"
    },
    "ParsedDocument": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Document Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.1",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceDescriptor"
        },
        "identity": {
          "$ref": "#/$defs/DocumentIdentity"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/Page"
          },
          "title": "Pages",
          "type": "array"
        },
        "elements": {
          "items": {
            "$ref": "#/$defs/Element"
          },
          "title": "Elements",
          "type": "array"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/Relation"
          },
          "title": "Relations",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "domain_pack": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain Pack"
        },
        "status": {
          "default": "parsed",
          "maxLength": 63,
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "parse_run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Parse Run Id",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "source",
        "pages",
        "elements",
        "evidence",
        "parse_run_id"
      ],
      "title": "ParsedDocument",
      "type": "object"
    },
    "PixelBoundingBox": {
      "additionalProperties": false,
      "properties": {
        "x1": {
          "minimum": 0.0,
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "minimum": 0.0,
          "title": "Y1",
          "type": "number"
        },
        "x2": {
          "minimum": 0.0,
          "title": "X2",
          "type": "number"
        },
        "y2": {
          "minimum": 0.0,
          "title": "Y2",
          "type": "number"
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "title": "PixelBoundingBox",
      "type": "object"
    },
    "Relation": {
      "additionalProperties": false,
      "properties": {
        "relation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Relation Id",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "domain_type": {
          "anyOf": [
            {
              "maxLength": 127,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain Type"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "unreviewed"
        }
      },
      "required": [
        "relation_id",
        "source_id",
        "target_id",
        "type",
        "confidence",
        "evidence_ids"
      ],
      "title": "Relation",
      "type": "object"
    },
    "ResourceUsage": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "minimum": 0.0,
          "title": "Duration Ms",
          "type": "number"
        },
        "max_rss_kb": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Rss Kb"
        },
        "input_bytes": {
          "minimum": 0,
          "title": "Input Bytes",
          "type": "integer"
        },
        "output_elements": {
          "minimum": 0,
          "title": "Output Elements",
          "type": "integer"
        },
        "estimated_cost_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Estimated Cost Usd",
          "type": "number"
        }
      },
      "required": [
        "duration_ms",
        "input_bytes",
        "output_elements"
      ],
      "title": "ResourceUsage",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "unreviewed",
        "reviewed",
        "rejected"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "RunStatus": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "SourceDescriptor": {
      "additionalProperties": false,
      "properties": {
        "filename": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "mime_type": {
          "maxLength": 127,
          "minLength": 1,
          "title": "Mime Type",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ref"
        }
      },
      "required": [
        "filename",
        "sha256",
        "mime_type",
        "size_bytes"
      ],
      "title": "SourceDescriptor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "document": {
      "$ref": "#/$defs/ParsedDocument"
    },
    "run": {
      "$ref": "#/$defs/ParseRun"
    },
    "raw_output": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Output"
    },
    "binary_artifacts": {
      "additionalProperties": {
        "format": "binary",
        "type": "string"
      },
      "title": "Binary Artifacts",
      "type": "object"
    }
  },
  "required": [
    "document",
    "run"
  ],
  "title": "ParserResult",
  "type": "object"
}

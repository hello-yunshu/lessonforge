{
  "$defs": {
    "CampaignAction": {
      "enum": [
        "start",
        "pause",
        "resume",
        "cancel",
        "claim-step",
        "heartbeat",
        "link-evidence",
        "checkpoint",
        "complete-step",
        "fail-step",
        "retry-step",
        "finalize"
      ],
      "title": "CampaignAction",
      "type": "string"
    },
    "CampaignEvidenceKind": {
      "enum": [
        "dataset",
        "parser",
        "scale",
        "supply-chain",
        "license",
        "pilot",
        "report"
      ],
      "title": "CampaignEvidenceKind",
      "type": "string"
    },
    "StepCheckpointRequest": {
      "additionalProperties": false,
      "properties": {
        "worker_id_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Worker Id Hash",
          "type": "string"
        },
        "lease_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Lease Id",
          "type": "string"
        },
        "completed_units": {
          "minimum": 0,
          "title": "Completed Units",
          "type": "integer"
        },
        "total_units": {
          "minimum": 1,
          "title": "Total Units",
          "type": "integer"
        },
        "cursor_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cursor Sha256",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "maxProperties": 64,
          "title": "Metrics",
          "type": "object"
        }
      },
      "required": [
        "worker_id_hash",
        "lease_id",
        "completed_units",
        "total_units",
        "cursor_sha256"
      ],
      "title": "StepCheckpointRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Event Id",
      "type": "string"
    },
    "campaign_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Campaign Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "previous_event_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Event Sha256"
    },
    "action": {
      "$ref": "#/$defs/CampaignAction"
    },
    "actor_id_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Actor Id Hash",
      "type": "string"
    },
    "step_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Step Id"
    },
    "worker_id_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Worker Id Hash"
    },
    "lease_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Id"
    },
    "lease_expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Expires At"
    },
    "evidence_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/CampaignEvidenceKind"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Id"
    },
    "evidence_semantic_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Semantic Sha256"
    },
    "checkpoint": {
      "anyOf": [
        {
          "$ref": "#/$defs/StepCheckpointRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "note": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "immutable": {
      "const": true,
      "default": true,
      "title": "Immutable",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "campaign_id",
    "sequence",
    "action",
    "actor_id_hash"
  ],
  "title": "CampaignEvent",
  "type": "object"
}

# 教材分析系统环境变量配置
#
# 使用方法：
# 1. 复制本文件为 .env
# 2. 填入你的 API Key
# 3. 重启开发服务器（npm run dev）
#
# API Key 获取地址：
# Google Gemini: https://aistudio.google.com/apikey

# Google Gemini API Key（推荐，免费额度充足）
GEMINI_API_KEY=your_api_key_here

# 可选：指定模型（默认 gemini-2.0-flash）
# AI_MODEL=gemini-2.0-flash

# 可选：OpenAI 兼容 API（如需使用其他服务）
# OPENAI_API_KEY=your_openai_key

# document-intelligence 文档智能解析服务地址（默认 http://localhost:8080）
# 需先运行「启动文档智能解析服务.bat」启动 FastAPI 服务
# DI_SERVICE_URL=http://localhost:8080
